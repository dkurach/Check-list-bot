# Создаётся установщиком (install.bat / install.command). Пример для ручной настройки.
BOT_TOKEN=123456:ABC...
TIMEZONE=Europe/Moscow
# Telegram ID главных админов через запятую (необязательно: проще войти по ссылке из установки)
ADMIN_IDS=
# Через сколько минут после срока сообщать старшим и админу
ESCALATE_AFTER_MIN=30
# Код первого входа администратора: /start <код>
SETUP_CODE=
