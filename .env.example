# Создаётся установщиком (install.bat / install.command). Пример для ручной настройки.
BOT_TOKEN=123456:ABC...
TIMEZONE=Europe/Moscow
# Telegram ID главных админов через запятую (необязательно: проще войти по ссылке из установки)
ADMIN_IDS=
# Через сколько минут после срока сообщать старшим и админу
ESCALATE_AFTER_MIN=30
# Начало рабочих суток: задачи и смены до этого времени относятся к предыдущему дню (работа после полуночи)
DAY_START=05:00
# Код первого входа администратора: /start <код>
SETUP_CODE=
# Автообновление из релизов GitHub (1 - включено, 0 - выключено)
AUTO_UPDATE=1
# Токен GitHub только на чтение репозитория (нужен, пока репозиторий приватный)
GITHUB_TOKEN=
